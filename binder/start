#!/bin/bash
# Runs every time a user server starts, before Jupyter.
MYSQL_HOME="${HOME}/.spyglass-mysql"
SHARED="${SHARED_DATA_DIR:-${HOME}/data}"
RAW="${HOME}/spyglass_data/raw"

# Start MySQL in the background and wait (max ~30 s) until it answers.
mysqld --defaults-file="${MYSQL_HOME}/my.cnf" >/dev/null 2>&1 &
for i in $(seq 1 30); do
  mysqladmin --defaults-file="${MYSQL_HOME}/my.cnf" -u root --password=tutorial ping >/dev/null 2>&1 && break
  sleep 1
done

# Expose read-only shared NWB files in Spyglass's (writable) raw dir, so that
# Spyglass can write its "<name>_.nwb" copies next to them.
mkdir -p "${RAW}"
for f in "${SHARED}"/spyglass/raw/*.nwb "${SHARED}"/*.nwb; do
  [ -e "$f" ] || continue
  ln -sf "$f" "${RAW}/$(basename "$f")"
done

exec "$@"
